{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/GenjiruSUchiwa/repo-router/master/crates/rr-cli/tests/query.schema.json",
  "title": "RepoRouterQueryResultV1",
  "description": "Schema for repo-router query output v1",
  "oneOf": [
    { "$ref": "#/$defs/DirectResult" },
    { "$ref": "#/$defs/CandidatesResult" },
    { "$ref": "#/$defs/NoneResult" }
  ],
  "$defs": {
    "Pipeline": {
      "type": "string",
      "enum": ["exact", "lexical", "route"]
    },
    "LineRange": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2,
      "$comment": "The renderer enforces end >= start because standard JSON Schema has no portable array-value comparison."
    },
    "FileAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "symbol", "lines"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "const": null
        },
        "lines": {
          "const": null
        }
      }
    },
    "SymbolAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "symbol", "lines"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "$ref": "#/$defs/LineRange"
        }
      }
    },
    "Anchor": {
      "oneOf": [
        { "$ref": "#/$defs/FileAnchor" },
        { "$ref": "#/$defs/SymbolAnchor" }
      ]
    },
    "Confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "CandidateItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor", "confidence"],
      "properties": {
        "anchor": {
          "$ref": "#/$defs/Anchor"
        },
        "confidence": {
          "oneOf": [
            { "$ref": "#/$defs/Confidence" },
            { "type": "null" }
          ]
        }
      }
    },
    "RankingEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "posting_hits_scanned",
        "candidates_before_cap",
        "candidates_scored",
        "candidates_dropped",
        "cap_cut_a_tie",
        "effective_query_terms"
      ],
      "properties": {
        "posting_hits_scanned": { "type": "integer", "minimum": 0 },
        "candidates_before_cap": { "type": "integer", "minimum": 0 },
        "candidates_scored": { "type": "integer", "minimum": 0 },
        "candidates_dropped": { "type": "integer", "minimum": 0 },
        "cap_cut_a_tie": {
          "type": "boolean",
          "$comment": "True when the candidate cap discarded a union member the retention key ranked equal to the worst member it kept. The survivors were then settled on symbol id, which is the order the files happened to be indexed in, so a discarded member could have outscored every answer shown."
        },
        "effective_query_terms": { "type": "integer", "minimum": 0 }
      }
    },
    "Explain": {
      "oneOf": [
        { "$ref": "#/$defs/RankingEvidence" },
        { "type": "null" }
      ],
      "$comment": "Present only when --explain is passed, and null when the query routed exactly and read no posting list. Optional, so every response that validated before this member existed still validates."
    },
    "ContentRepresentation": {
      "type": "string",
      "enum": ["git-canonical", "raw-no-git"],
      "$comment": "Whether the verified identity is a Git-canonical blob OID or a local content hash taken outside a repository."
    },
    "Span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_byte", "end_byte", "start_line", "end_line"],
      "properties": {
        "start_byte": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "end_byte": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "start_line": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "end_line": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      },
      "$comment": "The anchor's own span in the verified content, exactly as indexed: never clamped, normalized, or re-derived for output."
    },
    "VerifiedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "representation",
        "span",
        "requested_lines",
        "served_lines",
        "complete",
        "context_clipped",
        "omitted_anchor_lines",
        "omitted_anchor_bytes",
        "ends_with_newline",
        "content"
      ],
      "properties": {
        "status": { "const": "verified" },
        "representation": { "$ref": "#/$defs/ContentRepresentation" },
        "span": { "$ref": "#/$defs/Span" },
        "requested_lines": {
          "$ref": "#/$defs/LineRange",
          "$comment": "The window selection set out to produce: the anchor plus up to three context lines on each side that exist, or the anchor alone once a budget truncated it, since context is never asked for in that case."
        },
        "served_lines": {
          "$ref": "#/$defs/LineRange",
          "$comment": "The window actually present in content. Narrower than requested_lines exactly when a budget cut it."
        },
        "complete": {
          "type": "boolean",
          "$comment": "True when every anchor line is present. Context omitted by a budget does not make an anchor incomplete."
        },
        "context_clipped": {
          "type": "boolean",
          "$comment": "True when a context line that exists was dropped by a budget. Independent of complete: a truncated anchor reports truncation alone."
        },
        "omitted_anchor_lines": { "type": "integer", "minimum": 0 },
        "omitted_anchor_bytes": { "type": "integer", "minimum": 0 },
        "ends_with_newline": {
          "type": "boolean",
          "$comment": "Whether content itself ends with a line feed. Text output appends one structural LF regardless."
        },
        "content": { "type": "string" }
      }
    },
    "RefusedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "stale",
            "missing",
            "symlink",
            "not-regular",
            "too-large",
            "line-too-long",
            "not-text",
            "raced"
          ]
        }
      },
      "$comment": "A refusal carries its status and nothing else: no content, preview, current OID, or relocated line number. Content OIDs are verification internals and never appear in query output."
    },
    "Source": {
      "oneOf": [
        { "$ref": "#/$defs/VerifiedSource" },
        { "$ref": "#/$defs/RefusedSource" }
      ],
      "$comment": "Present only when --source is passed and routing returned one direct anchor."
    },
    "DirectResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "result", "pipeline", "anchor", "confidence"],
      "properties": {
        "v": {
          "type": "integer",
          "const": 1
        },
        "result": {
          "type": "string",
          "const": "direct"
        },
        "pipeline": {
          "$ref": "#/$defs/Pipeline"
        },
        "anchor": {
          "$ref": "#/$defs/Anchor"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "explain": {
          "$ref": "#/$defs/Explain"
        }
      }
    },
    "CandidatesResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "result", "pipeline", "candidates"],
      "properties": {
        "v": {
          "type": "integer",
          "const": 1
        },
        "result": {
          "type": "string",
          "const": "candidates"
        },
        "pipeline": {
          "$ref": "#/$defs/Pipeline"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/CandidateItem"
          }
        },
        "explain": {
          "$ref": "#/$defs/Explain"
        }
      }
    },
    "NoneResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "result", "pipeline", "reason"],
      "properties": {
        "v": {
          "type": "integer",
          "const": 1
        },
        "result": {
          "type": "string",
          "const": "none"
        },
        "pipeline": {
          "$ref": "#/$defs/Pipeline"
        },
        "reason": {
          "type": "string",
          "enum": ["not_found", "low_confidence"]
        },
        "explain": {
          "$ref": "#/$defs/Explain"
        }
      }
    }
  }
}
